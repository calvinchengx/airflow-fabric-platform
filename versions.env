# The platform's dependencies, pinned. Moved by scripts/set_release.py when
# fabric-emulator publishes, so no product repo has to change.
#
# Airflow 3 is a deliberate floor, not an incidental pin: its DAG-bundle
# discovery and Task SDK boundary are what let the same DAGs run on a managed
# Airflow in production.
AIRFLOW_VERSION=3.3.1
# Pinned BY DIGEST, not by tag alone. Every fabric-emulator release rebuilds
# and overwrites the tags it publishes, so a tag names a moving target: 0.7.0
# stayed "Sail 0.7.0" while its digest moved 807adeb9 -> 0d2fe3c7 in one
# release. The digest is the pin; the version is documentation.
FABRIC_EMULATOR_VERSION=0.28.0
FABRIC_EMULATOR_DIGEST=sha256:9cdc8d14d4940360a21d6aab06ae1afc0ca2b1689d5b5a02f3e0e4f0b74c371c
ENTRA_EMULATOR_VERSION=0.8.1
POSTGRES_VERSION=16

# The Fabric target's COMPUTE and its Warehouse engine. A Fabric target is not
# just REST and OneLake: dbt-fabricspark submits silver to Livy, which the
# emulator drives through the statement agent onto Sail, and dbt-fabric writes
# gold over TDS. Both are part of the target, so both are pinned here.
#
# BY DIGEST, and these move. Their tags name the DEPENDENCY (Sail 0.7.0, the
# pyspark client 4.2.0), not a release, so every fabric-emulator release
# rebuilds and overwrites them: v0.28.0 moved sail 0d2fe3c7 -> 3f2f44b5 and the
# agent 7af93f6d -> 91045868 while both tags stayed put.
SAIL_ENGINE_VERSION=0.7.0
SAIL_ENGINE_DIGEST=sha256:3f2f44b5013125fae565cb1bfdfa91d86e6f3c17f33dd87dedc27f015b3b83f0
SPARK_CLIENT_VERSION=4.2.0
SPARK_CLIENT_DIGEST=sha256:91045868364c91859d3be594982b6982306d882334f7d1406f296b73638850de
MSSQL_VERSION=2022-latest
